{
  "name": "dsh-bash-guard",
  "version": "0.2.1-rc.2",
  "license": "MIT",
  "author": "lloydzhou (https://github.com/lloydzhou)",
  "homepage": "https://github.com/lloydzhou/dsh-bash-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydzhou/dsh-bash-guard.git"
  },
  "bugs": {
    "url": "https://github.com/lloydzhou/dsh-bash-guard/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bash",
    "permissions"
  ],
  "type": "module",
  "description": "Workspace-based Bash Guard policy with native inline permission controls",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "undici": "^6.29.1"
  }
}
